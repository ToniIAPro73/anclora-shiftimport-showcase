{
  "name": "anclora-shiftimport-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Demo interactiva de portfolio para Anclora ShiftImport con datos sintéticos",
  "scripts": {
    "dev": "node -e \"const p='../anclora-infrastructure/scripts/free-port.mjs';if(require('fs').existsSync(p)){try{require('child_process').execFileSync(process.execPath,[p],{stdio:'inherit'})}catch(e){process.exit(e.status||1)}}\" && vite --port 3041 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "node -e \"const p='../anclora-infrastructure/scripts/free-port.mjs';if(require('fs').existsSync(p)){try{require('child_process').execFileSync(process.execPath,[p,'--port','4173'],{stdio:'inherit'})}catch(e){process.exit(e.status||1)}}\" && vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.11"
  }
}
